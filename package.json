{
  "name": "astrajunior",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-size.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "browser": "node scripts/browser-tests.mjs",
    "acceptance:print": "node scripts/print-check.mjs",
    "acceptance:flow": "node scripts/flow-check.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.18.0"
}
